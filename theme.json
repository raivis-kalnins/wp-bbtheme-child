{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "840px", "wideSize": "1240px" },
    "color": {
      "palette": [
        { "slug": "charcoal", "name": "Charcoal", "color": "#1f2937" },
        { "slug": "slate", "name": "Slate", "color": "#475569" },
        { "slug": "mist", "name": "Mist", "color": "#f4f4f5" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"] },
    "typography": { "fluid": true }
  },
  "styles": {
    "typography": { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "lineHeight": "1.6" },
    "elements": { "heading": { "typography": { "fontWeight": "750", "lineHeight": "1.1" } } }
  }
}
