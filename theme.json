{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "charcoal",
          "name": "Charcoal",
          "color": "#20262d"
        },
        {
          "slug": "slate",
          "name": "Slate",
          "color": "#4b5563"
        },
        {
          "slug": "mist",
          "name": "Mist",
          "color": "#f3f4f5"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    },
    "typography": {
      "fluid": false
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "750",
          "lineHeight": "1.1"
        }
      }
    }
  }
}
